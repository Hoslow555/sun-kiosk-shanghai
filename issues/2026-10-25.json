  "lines": {
    "greet": [
      "开张了，上海的第一份报纸给你留着。",
      "来啦，今天先沿五条不同的小路逛逛。",
      "柜台有报纸，也有我那杯还热的茶。"
    ],
    "buy": [
      "十个太阳币，五个去处，慢慢看。",
      "拿好，别让伦敦的风把头版吹跑。",
      "报纸交给你，下一期等你的回执。"
    ],
    "debt": [
      "先拿着，账记着，回来聊聊就行。",
      "又记一笔，我的账本比盔甲还厚。"
    ],
    "chat": [
      "刚开张，我还没摸准你的口味。",
      "你说想去的，我会记在下一摞报纸旁。",
      "梅林那老头查链接，我负责守柜台。",
      "公园的夜班开了，我的茶也还没凉。",
      "不着急选，先让这五个去处混个脸熟。"
    ],
    "weather": [
      "上海今天阴，夜里凉，出门看看新预报。",
      "你那边十八到二十三度，我这边茶还烫。"
    ],
    "quip": [
      "飞船又赶路去了，我还在赶明天的报纸。",
      "星星居然也能变颜色，我的围巾不服。",
      "望远镜忙着调试，我忙着调这盏柜台灯。",
      "那老头要是借了单车，可别停进我的报架。",
      "老建筑不用会说话，慢慢走也有得听。"
    ],
    "nudge": [
      "读完投张回执，让我知道下次进什么货。"
    ],
    "care": []
  },
  "answers": []
}
